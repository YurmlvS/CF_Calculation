{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist-server",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "server/**/*.ts",
    "src/modules/y-brace/calculate.ts",
    "src/modules/y-brace/materials.ts",
    "src/modules/y-brace/phiUtils.ts",
    "src/modules/y-brace/phiTable.ts"
  ]
}
